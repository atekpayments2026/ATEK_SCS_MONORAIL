import java.time.Instant;

CREATE TABLE IF NOT EXISTS AnalyticsTable (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    equipmentId TEXT NOT NULL,
    passId INTEGER NOT NULL,
    productId INTEGER NOT NULL,
    mediaTypeId INTEGER NOT NULL,
    entryCount INTEGER NOT NULL,
    exitCount INTEGER NOT NULL,
    totalCount INTEGER NOT NULL,
    createdAt TEXT AS Instant NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),
    updatedAt TEXT AS Instant NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_analytics_equipmentId_passId ON AnalyticsTable(equipmentId, passId);
CREATE INDEX IF NOT EXISTS idx_analytics_mediaTypeId ON AnalyticsTable(mediaTypeId);

saveOrUpdate:
INSERT OR REPLACE INTO AnalyticsTable (
    equipmentId,
    passId,
    productId,
    mediaTypeId,
    entryCount,
    exitCount,
    totalCount,
    createdAt,
    updatedAt
) VALUES ?;

getAll:
SELECT * FROM AnalyticsTable;

getSummaryByMediaType:
SELECT
    mediaTypeId,
    SUM(entryCount) AS totalEntryCount,
    SUM(exitCount) AS totalExitCount,
    SUM(totalCount) AS grandTotalCount
FROM AnalyticsTable
GROUP BY mediaTypeId
ORDER BY mediaTypeId;

deleteAll:
DELETE FROM AnalyticsTable;